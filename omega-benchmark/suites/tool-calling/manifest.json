{
  "id": "tool-basic",
  "track": "tool_calling",
  "description": "Basic tool calling evaluation: single tool selection, argument matching, and irrelevance rejection.",
  "cases": [
    {
      "id": "tc-simple-read",
      "prompt": "Read the contents of /tmp/hello.txt",
      "expected": {
        "kind": "tool_calls",
        "calls": [
          {
            "name": "read_file",
            "arguments": { "path": "/tmp/hello.txt" }
          }
        ]
      },
      "allowed_tools": ["read_file", "write_file", "list_dir"],
      "tags": ["simple"]
    },
    {
      "id": "tc-simple-write",
      "prompt": "Create a file at /tmp/output.txt with the content 'hello world'",
      "expected": {
        "kind": "tool_calls",
        "calls": [
          {
            "name": "write_file",
            "arguments": { "path": "/tmp/output.txt", "content": "hello world" }
          }
        ]
      },
      "allowed_tools": ["read_file", "write_file", "list_dir"],
      "tags": ["simple"]
    },
    {
      "id": "tc-multi-tools",
      "prompt": "Read /tmp/a.txt and /tmp/b.txt, then write their combined content to /tmp/merged.txt",
      "expected": {
        "kind": "tool_calls",
        "calls": [
          { "name": "read_file", "arguments": { "path": "/tmp/a.txt" } },
          { "name": "read_file", "arguments": { "path": "/tmp/b.txt" } },
          { "name": "write_file", "arguments": { "path": "/tmp/merged.txt" } }
        ]
      },
      "allowed_tools": ["read_file", "write_file", "list_dir"],
      "tags": ["multiple"]
    },
    {
      "id": "tc-irrelevant-chat",
      "prompt": "What is the capital of France?",
      "expected": { "kind": "no_tool_call" },
      "allowed_tools": ["read_file", "write_file", "list_dir"],
      "tags": ["irrelevance"]
    },
    {
      "id": "tc-irrelevant-opinion",
      "prompt": "Do you prefer Python or Rust?",
      "expected": { "kind": "no_tool_call" },
      "allowed_tools": ["read_file", "write_file", "search"],
      "tags": ["irrelevance"]
    }
  ]
}
